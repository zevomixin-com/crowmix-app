{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "services",
    "store",
    "types",
    "hooks"
  ],
  "extends": "expo/tsconfig.base"
}
